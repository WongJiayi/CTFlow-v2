Bootstrap: docker
From: nvidia/cuda:12.1.0-devel-ubuntu22.04

%files
    environment_v2.yaml /

%post -c /bin/bash
    set -euo pipefail

    echo "🔧 替换 apt 源为中科大源..."
    sed -i 's|http://archive.ubuntu.com/ubuntu/|https://mirrors.ustc.edu.cn/ubuntu/|g' /etc/apt/sources.list

    # 1) 系统依赖
    apt-get update && \
      apt-get install -y --no-install-recommends \
        rdma-core \
        libibverbs1 \
        ibverbs-utils \
        libmlx5-1 \
        curl bzip2 git ca-certificates build-essential && \
      rm -rf /var/lib/apt/lists/*

    # 2) Miniconda
    curl -fsSL https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -o /tmp/conda.sh
    bash /tmp/conda.sh -b -p /opt/conda
    rm -f /tmp/conda.sh

    # 3) 初始化 conda & 处理 ToS / 渠道
    export PATH=/opt/conda/bin:$PATH
    . /opt/conda/etc/profile.d/conda.sh
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main || true
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r    || true
    conda config --system --set channel_priority strict
    conda config --system --remove channels defaults || true
    conda config --system --add channels conda-forge

    # 4) 用 mamba 创建环境（只装基础栈）
    conda install -y -n base mamba
    mamba env create -f /environment_v2.yaml --override-channels -c conda-forge -n diffusors_ctrate

    # 5) 激活环境，pip 装 CUDA 轮子 & 生态
    . /opt/conda/etc/profile.d/conda.sh
    conda activate diffusors_ctrate

    # (a) PyTorch 2.2.2 + cu121 官方轮子
    python -m pip install --no-deps \
      --extra-index-url https://download.pytorch.org/whl/cu121 \
      torch==2.2.2+cu121 \
      torchvision==0.17.2+cu121 \
      torchaudio==2.2.2+cu121

    # (b) 上层生态（版本统一）
    # NOTE: transformers 用 Git 提交固定 ↓↓↓
    # 在本地执行： pip freeze | grep -i transformers
    # 若输出形如：transformers @ git+https://github.com/huggingface/transformers
    # 就把 <COMMIT> 填到下面
    python -m pip install \
      accelerate==0.34.2 \
      pytorch-lightning==2.4.0 \
      diffusers==0.30.3 \
      "git+https://github.com/huggingface/transformers" \
      timm==0.9.16 \
      einops omegaconf pillow safetensors tqdm wandb==0.16.5 \
      imageio==2.34.0 moviepy==1.0.3 jsonschema==4.23.0 torchdiffeq==0.2.4 \
      sentencepiece peft optuna iopath triton \
      xformers==0.0.27.post2 \
      git+https://github.com/KellerJordan/Muon

    # 6) 产出激活脚本
    echo '. /opt/conda/etc/profile.d/conda.sh && conda activate diffusors_ctrate' > /environment.sh
    chmod +x /environment.sh

%environment
    . /environment.sh

%runscript
    exec bash
